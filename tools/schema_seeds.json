  "schemas": [
    {
      "scope": "behavior",
      "family": "animation",
      "version": "1.10.0",
      "format_value": "1.10.0",
      "root": "animations",
      "stable": true,
      "docs": "pack_contents",
      "document": {
        "format_version": "1.10.0",
        "animations": {
          "animation.example": {
            "loop": true,
            "animation_length": 1.0,
            "bones": {
              "body": {
                "rotation": [
                  0,
                  0,
                  0
                ],
                "position": [
                  0,
                  0,
                  0
                ],
                "scale": [
                  1,
                  1,
                  1
                ]
              }
            }
          }
        }
      }
    },
    {
      "scope": "behavior",
      "family": "animation_controller",
      "version": "1.10.0",
      "format_value": "1.10.0",
      "root": "animation_controllers",
      "stable": true,
      "docs": "pack_contents",
      "document": {
        "format_version": "1.10.0",
        "animation_controllers": {
          "controller.animation.example": {
            "initial_state": "default",
            "states": {
              "default": {
                "animations": [
                  "animation.example"
                ],
                "transitions": [
                  {
                    "next": "1.0"
                  }
                ],
                "on_entry": [
                  "@s example:event"
                ],
                "on_exit": [
                  "@s example:event"
                ],
                "blend_transition": 0.2
              }
            }
          }
        }
      }
    },
    {
      "scope": "behavior",
      "family": "block",
      "version": "1.26.0",
      "format_value": "1.26.0",
      "root": "minecraft:block",
      "stable": true,
      "docs": "blocks",
      "document": {
        "format_version": "1.26.0",
        "minecraft:block": {
          "description": {
            "identifier": "example:block",
            "menu_category": {
              "category": "construction",
              "group": "itemGroup.name.concrete"
            }
          },
          "components": {
            "minecraft:collision_box": {
              "origin": [
                -8,
                0,
                -8
              ],
              "size": [
                16,
                16,
                16
              ]
            },
            "minecraft:selection_box": {
              "origin": [
                -8,
                0,
                -8
              ],
              "size": [
                16,
                16,
                16
              ]
            },
            "minecraft:destroy_time": 1.0,
            "minecraft:display_name": "tile.example:block.name",
            "minecraft:explosion_resistance": 1.0,
            "minecraft:flammable": {
              "flame_odds": 5,
              "burn_odds": 5
            },
            "minecraft:friction": 0.4,
            "minecraft:geometry": {
              "identifier": "geometry.example",
              "bone_visibility": {
                "root": true
              }
            },
            "minecraft:light_dampening": 15,
            "minecraft:light_emission": 0,
            "minecraft:loot": "loot_tables/blocks/example.json",
            "minecraft:map_color": "#ffffff",
            "minecraft:material_instances": {
              "*": {
                "texture": "example",
                "render_method": "opaque",
                "face_dimming": true,
                "ambient_occlusion": true
              }
            },
            "minecraft:transformation": {
              "translation": [
                0,
                0,
                0
              ],
              "rotation": [
                0,
                0,
                0
              ],
              "scale": [
                1,
                1,
                1
              ]
            },
            "minecraft:unit_cube": {}
          },
          "permutations": [
            {
              "condition": "query.block_state('example:state') == 1",
              "components": {
                "minecraft:light_emission": 1
              }
            }
          ]
        }
      }
    },
    {
      "scope": "behavior",
      "family": "dialogue",
      "version": "1.17",
