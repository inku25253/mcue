      "document": {
        "format_version": "1.17",
        "minecraft:npc_dialogue": {
          "scenes": [
            {
              "scene_tag": "example",
              "npc_name": "NPC",
              "text": "Hello",
              "on_open_commands": [
                "/say open"
              ],
              "on_close_commands": [
                "/say close"
              ],
              "buttons": [
                {
                  "name": "OK",
                  "commands": [
                    "/say ok"
                  ]
                }
              ]
            }
          ]
        }
      }
